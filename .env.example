# Photobooth Studio OS - Environment Configuration
# Copy this file to .env for local configuration. Never commit real credentials!

# Application Mode
VITE_APP_NAME="Photobooth Studio OS"
VITE_APP_VERSION="1.0.0"

# Hardware Defaults
VITE_DEFAULT_PRINTER_NAME="EPSON83442C (L3250 Series)"
VITE_DEFAULT_CAMERA_ADAPTER="mock" # Options: mock | webcam | dslr

# Digital Gallery & Cloud Synchronization (Optional Supabase Configuration)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"
VITE_PUBLIC_GALLERY_BASE_URL="https://gallery.photobooth-cloud.com/session/"

# Local Network Fallback Port
VITE_LOCAL_GALLERY_PORT=8080
